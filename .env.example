# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/yt_shorts_automation

# Redis (BullMQ Queue) - leave empty to use in-memory queue runner in dev
REDIS_URL=redis://127.0.0.1:6379

# JWT and Crypto Secrets (generate 32-byte hex for ENCRYPTION_KEY)
JWT_SECRET=replace_with_your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 & YouTube Data API v3
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/youtube/oauth2callback

# Cloudinary Storage (Direct Signed Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Providers
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_CLIP_DURATION_SEC=180
