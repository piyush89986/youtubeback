# Server Configuration
PORT=5000
NODE_ENV=production
# In production, set to your Vercel URL (e.g. https://youtubfr.vercel.app)
CLIENT_URL=https://youtubfr.vercel.app

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/zarvis?retryWrites=true&w=majority

# Redis (BullMQ Queue) - leave empty if using built-in persistent queue runner
REDIS_URL=

# JWT and Crypto Secrets (generate 32-byte hex for ENCRYPTION_KEY)
JWT_SECRET=replace_with_your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 & YouTube Data API v3
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# In production, set to your Render backend callback URL:
GOOGLE_REDIRECT_URI=https://youtubeback-osll.onrender.com/api/youtube/oauth2callback

# Cloudinary Storage (Direct Signed Uploads & Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Providers (gemini | openai)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
# Multi-Key Rotation Pool for OpenAI
OPENAI_API_KEY=your_primary_openai_api_key
OPENAI_API_KEY1=your_second_openai_api_key
OPENAI_API_KEY3=your_third_openai_api_key

# Processing Limits
MAX_UPLOAD_SIZE_MB=500
MAX_CLIP_DURATION_SEC=180
